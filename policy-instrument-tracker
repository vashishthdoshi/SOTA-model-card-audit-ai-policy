function getFiltered(){
  return DATA.filter(d=>{
    if(currentRegion!=='all' && d.region!==currentRegion) return false;
    if(currentStatus!=='all' && d.status!==currentStatus) return false;
    if(bmOnly && !bookmarks.has(d.id)) return false;
    if(currentSearch){
      const q = currentSearch.toLowerCase();
      const hay = [d.name,d.billId,d.regionLabel,d.jurisdiction,d.statusLabel,
                   ...d.relevance,...d.specific,...d.implications].join(' ').toLowerCase();
      if(!hay.includes(q)) return false;
    }
    return true;
  });
}

function getSorted(arr){
  if(!sortKeys.length) return arr;
  return [...arr].sort((a,b)=>{
    for(const {key,dir} of sortKeys){
      let va = getSortVal(a,key), vb = getSortVal(b,key);
      if(va<vb) return dir==='asc'?-1:1;
      if(va>vb) return dir==='asc'?1:-1;
    }
    return 0;
  });
}
function getSortVal(d,key){
  if(key==='region') return d.regionLabel;
  if(key==='name')   return d.name;
  if(key==='status') return d.statusLabel;
  if(key==='passage') return d.passageTimeline[0]?.l||'';
  if(key==='activation') return d.activationTimeline[0]?.l||'';
  return '';
}

// ═══════════════════════════════════════════════════════════
// SORT INTERACTION
// ═══════════════════════════════════════════════════════════
function doSort(key, e){
  if(e.shiftKey){
    const ex = sortKeys.find(k=>k.key===key);
    if(ex) ex.dir = ex.dir==='asc'?'desc':'asc';
    else if(sortKeys.length<2) sortKeys.push({key,dir:'asc'});
  } else {
    const ex = sortKeys.find(k=>k.key===key);
    if(sortKeys.length===1 && ex) ex.dir = ex.dir==='asc'?'desc':'asc';
    else sortKeys = [{key,dir:'asc'}];
  }
  updateSortHeaders();
  renderRows();
  syncURL();
}
function updateSortHeaders(){
  document.querySelectorAll('th[onclick]').forEach(th=>{
    th.classList.remove('sort-asc','sort-desc','sort2-asc','sort2-desc');
  });
  sortKeys.forEach(({key,dir},i)=>{
    const map = {region:'c1',name:'c2',status:'c3',passage:'c8',activation:'c9'};
    const th = document.querySelector(`th[data-col="${map[key]}"]`);
    if(!th) return;
    if(i===0) th.classList.add(dir==='asc'?'sort-asc':'sort-desc');
    else th.classList.add(dir==='asc'?'sort2-asc':'sort2-desc');
  });
}

// ═══════════════════════════════════════════════════════════
// FILTER INTERACTIONS
// ═══════════════════════════════════════════════════════════
function setRegion(btn){
  currentRegion = btn.dataset.region;
  document.querySelectorAll('[data-region]').forEach(b=>b.classList.remove('on'));
  btn.classList.add('on');
  renderRows();
  syncURL();
}
function setStatus(btn){
  currentStatus = btn.dataset.status;
  document.querySelectorAll('[data-status]').forEach(b=>b.classList.remove('on'));
  btn.classList.add('on');
  renderRows();
  syncURL();
}
function doSearch(){
  currentSearch = document.getElementById('searchInput').value;
  renderRows();
  syncURL();
}

// ═══════════════════════════════════════════════════════════
// URL SYNC
// ═══════════════════════════════════════════════════════════
function syncURL(){
  const p = new URLSearchParams();
  if(currentRegion!=='all') p.set('region',currentRegion);
  if(currentStatus!=='all') p.set('status',currentStatus);
  if(currentSearch) p.set('q',currentSearch);
  if(sortKeys.length) p.set('sort',sortKeys.map(k=>k.key+'-'+k.dir).join(','));
  const str = p.toString();
  history.replaceState(null,'',str?('?'+str):window.location.pathname);
}
function readURL(){
  const p = new URLSearchParams(window.location.search);
  if(p.has('region')){
    currentRegion = p.get('region');
    document.querySelector(`[data-region="${currentRegion}"]`)?.classList.add('on');
    document.querySelector('[data-region="all"]')?.classList.remove('on');
  }
  if(p.has('status')){
    currentStatus = p.get('status');
    document.querySelector(`[data-status="${currentStatus}"]`)?.classList.add('on');
    document.querySelector('[data-status="all"]')?.classList.remove('on');
  }
  if(p.has('q')){
    currentSearch = p.get('q');
    document.getElementById('searchInput').value = currentSearch;
  }
  if(p.has('sort')){
    sortKeys = p.get('sort').split(',').map(s=>{
      const [key,dir] = s.split('-');
      return {key,dir};
    });
    updateSortHeaders();
  }
  if(p.has('view')) setView(p.get('view'));
}

// ═══════════════════════════════════════════════════════════
// BOOKMARKS
// ═══════════════════════════════════════════════════════════
function toggleBm(e, id){
  e.stopPropagation();
  if(bookmarks.has(id)) bookmarks.delete(id);
  else bookmarks.add(id);
  sessionStorage.setItem('bm', JSON.stringify([...bookmarks]));
  renderRows();
}
function toggleBmFilter(){
  bmOnly = !bmOnly;
  document.getElementById('bmBtn').classList.toggle('on', bmOnly);
  renderRows();
}
function updateBmCount(){
  const el = document.getElementById('bmCount');
  if(bookmarks.size>0){el.style.display='inline';el.textContent=bookmarks.size;}
  else {el.style.display='none';}
}


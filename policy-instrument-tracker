function bl(arr){
  return '<ul class="bl">'+arr.map(x=>`<li>${x}</li>`).join('')+'</ul>';
}
function tls(arr){
  return arr.map(t=>`<span class="tl ${t.t==='a'?'a':t.t==='w'?'w':''}">${t.l}</span>`).join('');
}
function srcLink(url,label,cls=''){
  if(!url) return '<a class="src empty">— N/A —</a>';
  return `<a class="src${cls?(' '+cls):''}" href="${url}" target="_blank" rel="noopener">↗ ${label}</a>`;
}

function renderRows(){
  const filtered = getFiltered();
  const sorted   = getSorted(filtered);
  const tbody = document.getElementById('tableBody');
  tbody.innerHTML = '';
  sorted.forEach((d,i)=>{
    const bm = bookmarks.has(d.id);
    const tr = document.createElement('tr');
    tr.dataset.id = d.id;
    tr.dataset.idx = i;
    if(bm) tr.classList.add('bookmarked');
    tr.innerHTML = `
      <td class="td-bm"><span class="bm-star${bm?' on':''}" title="Bookmark" onclick="toggleBm(event,${d.id})">★</span></td>
      <td data-col="c1" class="tc1"><span class="badge">${d.regionLabel}</span><span class="badge-sub">${d.jurisdiction}</span></td>
      <td data-col="c2" class="tc2"><div class="law-name">${d.name}</div><div class="law-id">${d.billId}</div></td>
      <td data-col="c3" class="tc3"><span class="status ${d.status==='force'?'s-g':'s-r'}">${d.statusLabel}</span></td>
      <td data-col="c4" class="tc4">${srcLink(d.src1url,d.src1label)}</td>
      <td data-col="c5" class="tc5"><div class="trunc">${bl(d.relevance)}</div><div class="more-hint">↓ click to expand</div></td>
      <td data-col="c6" class="tc6"><div class="trunc">${bl(d.specific)}</div><div class="more-hint">↓ click to expand</div></td>
      <td data-col="c7" class="tc7"><div class="trunc">${bl(d.implications)}</div><div class="more-hint">↓ click to expand</div></td>
      <td data-col="c8" class="tc8">${tls(d.passageTimeline)}</td>
      <td data-col="c9" class="tc9">${tls(d.activationTimeline)}</td>
      <td data-col="c10" class="tc10">${srcLink(d.src2url,d.src2label)}</td>
      <td data-col="c11" class="tc11">${srcLink(d.src3url,d.src3label)}</td>
    `;
    tr.addEventListener('click', e=>{
      if(e.target.classList.contains('bm-star')) return;
      if(e.target.tagName==='A') return;
      tr.classList.toggle('expanded');
      focusedRow = i;
      highlightFocused();
    });
    tbody.appendChild(tr);
  });
  document.getElementById('rowCount').textContent = `${sorted.length} of ${DATA.length} rows`;
  updateBmCount();
}


<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Model Cards & AI Legislation — CMU 80736</title>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600;700&family=Source+Serif+4:ital,opsz,wght@0,8..60,300;0,8..60,400;0,8..60,500;1,8..60,300&family=JetBrains+Mono:wght@300;400;500&display=swap" rel="stylesheet">
<style>
:root {
  --navy:#0d1b2a; --navy-mid:#1a2e42; --navy-soft:#2c4a63; --navy-muted:#4a6a85; --navy-pale:#8aaec8;
  --off:#f8f7f4; --white:#ffffff; --border:#d4d0c8; --border-s:#e8e5df;
  --green:#1a5c35; --green-bg:#e8f2ed; --green-b:#b8d9c6; --green-dot:#2e7d4f;
  --red:#7a1a1a; --red-bg:#f5e8e8; --red-b:#d4b0b0; --red-dot:#9e2a2a;
  --txt:#1a2832; --txts:#3a4f5e; --txtm:#5e7a8a;
  --ribbon:48px;
}
*{box-sizing:border-box;margin:0;padding:0}
html,body{height:100%}
body{background:var(--off);color:var(--txt);font-family:'Source Serif 4',Georgia,serif;font-size:13.5px;line-height:1.6;padding-bottom:var(--ribbon)}

/* ── HEADER ── */
.hdr{background:var(--navy);padding:44px 56px 32px;position:relative;overflow:hidden}
.hdr::before{content:'';position:absolute;inset:0;background-image:linear-gradient(rgba(255,255,255,.025) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.025) 1px,transparent 1px);background-size:48px 48px}
.hdr-in{position:relative;z-index:1}
.hdr-tag{font-family:'JetBrains Mono',monospace;font-size:10px;letter-spacing:.2em;text-transform:uppercase;color:var(--navy-pale);margin-bottom:14px;display:flex;align-items:center;gap:10px}
.hdr-tag::before{content:'';display:block;width:24px;height:1px;background:var(--navy-pale)}
.hdr-title{font-family:'Playfair Display',serif;font-size:40px;font-weight:700;color:#fff;line-height:1.08;letter-spacing:-.4px;margin-bottom:8px}
.hdr-title em{font-style:italic;color:var(--navy-pale)}
.hdr-desc{font-family:'Source Serif 4',serif;font-size:14px;color:rgba(255,255,255,.5);font-weight:300;max-width:680px;line-height:1.65;margin-bottom:28px;font-style:italic}
.hdr-stats{display:flex;gap:0;border:1px solid rgba(255,255,255,.1);border-radius:5px;overflow:hidden;width:fit-content}
.stat{padding:11px 22px;border-right:1px solid rgba(255,255,255,.1);text-align:center}
.stat:last-child{border-right:none}
.stat-n{font-family:'Playfair Display',serif;font-size:22px;font-weight:600;color:#fff;display:block;line-height:1;margin-bottom:3px}
.stat-l{font-family:'JetBrains Mono',monospace;font-size:9px;letter-spacing:.12em;text-transform:uppercase;color:var(--navy-pale)}

/* ── TOOLBAR ── */
.toolbar{background:var(--white);border-bottom:1px solid var(--border);padding:0 56px;display:flex;align-items:stretch;height:52px;box-shadow:0 1px 8px rgba(13,27,42,.08);gap:0;position:sticky;top:0;z-index:90;flex-wrap:nowrap;overflow-x:auto}
.tb-sep{width:1px;background:var(--border-s);margin:10px 0;flex-shrink:0}
.tb-section{display:flex;align-items:center;gap:5px;padding:0 16px 0 0;flex-shrink:0}
.tb-section:first-child{padding-left:0}
.tb-lbl{font-family:'JetBrains Mono',monospace;font-size:9px;letter-spacing:.14em;text-transform:uppercase;color:var(--txtm);white-space:nowrap;margin-right:3px}
.view-tab{display:flex;align-items:center;gap:6px;padding:0 16px;font-family:'JetBrains Mono',monospace;font-size:10px;letter-spacing:.08em;text-transform:uppercase;cursor:pointer;border-bottom:2px solid transparent;color:var(--txtm);transition:all .15s;white-space:nowrap;background:none;border-top:none;border-left:none;border-right:none;height:52px}
.view-tab:hover{color:var(--navy)}
.view-tab.active{color:var(--navy);border-bottom-color:var(--navy)}
.chip{padding:4px 10px;border-radius:3px;border:1px solid var(--border);background:var(--off);font-family:'JetBrains Mono',monospace;font-size:9.5px;letter-spacing:.04em;cursor:pointer;color:var(--txts);transition:all .14s;white-space:nowrap;height:28px;line-height:1}
.chip:hover,.chip.on{background:var(--navy);color:#fff;border-color:var(--navy)}
.tb-search-wrap{position:relative;display:flex;align-items:center}
.tb-search-icon{position:absolute;left:8px;color:var(--navy-muted);font-size:13px;pointer-events:none;font-family:'JetBrains Mono',monospace}
.tb-search{padding:6px 10px 6px 26px;border:1px solid var(--border);border-radius:3px;background:var(--off);font-family:'Source Serif 4',serif;font-size:12.5px;color:var(--navy);width:200px;outline:none;transition:border-color .15s,width .2s;height:28px}
.tb-search:focus{border-color:var(--navy-soft);width:240px}
.act-btn{padding:5px 11px;border-radius:3px;border:1px solid var(--border);background:transparent;font-family:'JetBrains Mono',monospace;font-size:9px;letter-spacing:.05em;cursor:pointer;color:var(--txts);transition:all .14s;display:flex;align-items:center;gap:5px;height:28px;white-space:nowrap}
.act-btn:hover{background:var(--navy);color:#fff;border-color:var(--navy)}
.bm-count{background:var(--navy);color:#fff;border-radius:10px;padding:1px 5px;font-size:8px;margin-left:2px}
.tb-right{display:flex;align-items:center;gap:6px;margin-left:auto;padding-left:16px;flex-shrink:0}
.row-ct{font-family:'JetBrains Mono',monospace;font-size:10px;color:var(--txtm);white-space:nowrap;padding:0 0 0 12px}

/* ── COLUMN PANEL ── */
.col-panel{display:none;position:fixed;top:52px;right:56px;background:var(--white);border:1px solid var(--border);border-radius:5px;box-shadow:0 8px 24px rgba(13,27,42,.14);padding:18px;z-index:200;min-width:230px}
.col-panel.open{display:block}
.col-panel h4{font-family:'JetBrains Mono',monospace;font-size:9px;letter-spacing:.14em;text-transform:uppercase;color:var(--txtm);margin-bottom:12px}
.cp-row{display:flex;align-items:center;justify-content:space-between;padding:6px 0;border-bottom:1px solid var(--border-s)}
.cp-row:last-child{border-bottom:none}
.cp-lbl{font-family:'Source Serif 4',serif;font-size:12px;color:var(--txt);cursor:pointer;flex:1}
.cp-num{font-family:'JetBrains Mono',monospace;font-size:9px;color:var(--txtm);margin-right:8px}
.sw{width:28px;height:14px;background:var(--border);border-radius:7px;position:relative;cursor:pointer;transition:background .15s;flex-shrink:0}
.sw.on{background:var(--navy)}
.sw::after{content:'';position:absolute;width:10px;height:10px;background:#fff;border-radius:50%;top:2px;left:2px;transition:left .15s}
.sw.on::after{left:16px}

/* ── KEYBOARD HINT ── */
.kb-hint{position:fixed;bottom:calc(var(--ribbon) + 8px);right:16px;background:rgba(13,27,42,.9);color:rgba(255,255,255,.8);font-family:'JetBrains Mono',monospace;font-size:9px;letter-spacing:.06em;padding:8px 14px;border-radius:4px;display:none;z-index:150;line-height:1.8}
.kb-hint.show{display:block}

/* ── TABLE VIEW ── */
.tbl-view{padding:24px 56px 32px;display:block}
.tbl-view.hidden,.map-view.hidden{display:none}
.scroll-hint{text-align:center;font-family:'JetBrains Mono',monospace;font-size:10px;color:var(--txtm);letter-spacing:.08em;padding:6px;margin-bottom:4px}
table{border-collapse:collapse;width:100%;min-width:2500px;background:var(--white);border:1px solid var(--border);border-radius:6px;overflow:hidden}
table[data-hide~="c2"] [data-col="c2"]{display:none}
table[data-hide~="c3"] [data-col="c3"]{display:none}
table[data-hide~="c4"] [data-col="c4"]{display:none}
table[data-hide~="c5"] [data-col="c5"]{display:none}
table[data-hide~="c6"] [data-col="c6"]{display:none}
table[data-hide~="c7"] [data-col="c7"]{display:none}
table[data-hide~="c8"] [data-col="c8"]{display:none}
table[data-hide~="c9"] [data-col="c9"]{display:none}
table[data-hide~="c10"] [data-col="c10"]{display:none}
table[data-hide~="c11"] [data-col="c11"]{display:none}
thead tr{background:var(--navy-mid)}
th{padding:10px 13px;text-align:left;font-family:'JetBrains Mono',monospace;font-size:8.5px;letter-spacing:.1em;text-transform:uppercase;color:var(--navy-pale);font-weight:400;border-right:1px solid rgba(255,255,255,.06);white-space:nowrap;cursor:pointer;transition:color .12s;vertical-align:bottom;user-select:none}
th:hover{color:#fff}
th:last-child{border-right:none}
th .th-num{display:block;font-size:7px;color:rgba(255,255,255,.2);margin-bottom:3px;letter-spacing:.06em}
th .sort-ind{margin-left:4px;opacity:.3;font-size:9px;font-style:normal}
th.sort-asc .sort-ind,th.sort-desc .sort-ind{opacity:1;color:#f0d060}
th.sort-asc .sort-ind::after{content:'↑'}
th.sort-desc .sort-ind::after{content:'↓'}
th:not(.sort-asc):not(.sort-desc) .sort-ind::after{content:'↕'}
th.sort2-asc .sort-ind::after{content:'↑²';color:#f0d060;opacity:.6}
th.sort2-desc .sort-ind::after{content:'↓²';color:#f0d060;opacity:.6}

/* BM col */
.th-bm,.td-bm{width:34px;min-width:34px;padding:10px 6px !important;text-align:center !important;cursor:default !important;border-right:1px solid rgba(255,255,255,.06)}
.td-bm{border-right:1px solid var(--border-s)}
.bm-star{font-size:14px;cursor:pointer;color:var(--border);transition:color .12s;line-height:1;display:block}
.bm-star:hover{color:var(--navy-muted)}
.bm-star.on{color:var(--navy)}

tbody tr{border-bottom:1px solid var(--border-s);transition:background .1s;cursor:pointer}
tbody tr:last-child{border-bottom:none}
tbody tr:hover{background:#f2f0eb}
tbody tr.expanded{background:#edeae3}
tbody tr.focused{outline:2px solid var(--navy-soft);outline-offset:-2px}
tbody tr.hidden-row{display:none}
tbody tr.bookmarked{border-left:3px solid var(--navy)}

td{padding:12px 13px;vertical-align:top;border-right:1px solid var(--border-s);color:var(--txts);font-size:12.5px;line-height:1.55}
td:last-child{border-right:none}

/* column widths */
.tc1{width:105px;min-width:95px}
.tc2{width:195px;min-width:175px}
.tc3{width:115px;min-width:105px}
.tc4{width:88px;min-width:80px}
.tc5,.tc6,.tc7{width:235px;min-width:200px}
.tc8,.tc9{width:138px;min-width:120px}
.tc10,.tc11{width:86px;min-width:76px}

/* badges */
.badge{display:inline-block;padding:2px 8px;border-radius:2px;background:var(--navy);color:#fff;font-family:'JetBrains Mono',monospace;font-size:8.5px;letter-spacing:.1em;text-transform:uppercase;white-space:nowrap}
.badge-sub{display:block;font-family:'JetBrains Mono',monospace;font-size:9px;color:var(--navy-muted);margin-top:3px;letter-spacing:.03em}

/* status */
.status{display:inline-flex;align-items:center;gap:4px;padding:2px 8px;border-radius:2px;font-family:'JetBrains Mono',monospace;font-size:8.5px;letter-spacing:.05em;white-space:nowrap}
.status::before{content:'';width:5px;height:5px;border-radius:50%;flex-shrink:0}
.s-g{background:var(--green-bg);color:var(--green);border:1px solid var(--green-b)}
.s-g::before{background:var(--green-dot)}
.s-r{background:var(--red-bg);color:var(--red);border:1px solid var(--red-b)}
.s-r::before{background:var(--red-dot)}

/* law name */
.law-name{font-family:'Source Serif 4',serif;font-weight:500;color:var(--navy);font-size:13px;line-height:1.3;margin-bottom:2px}
.law-id{font-family:'JetBrains Mono',monospace;font-size:9px;color:var(--navy-muted);line-height:1.4}

/* bullet lists */
.bl{list-style:none;padding:0;margin:0}
.bl li{padding:1px 0 1px 13px;position:relative;font-size:12px;line-height:1.5;color:var(--txts)}
.bl li::before{content:'—';position:absolute;left:0;color:var(--navy-pale);font-family:'JetBrains Mono',monospace;font-size:9.5px;top:2px}

/* truncation */
.trunc{max-height:88px;overflow:hidden;transition:max-height .25s}
tr.expanded .trunc{max-height:500px}
.more-hint{font-family:'JetBrains Mono',monospace;font-size:9px;color:var(--navy-pale);margin-top:2px}
tr.expanded .more-hint{display:none}

/* timeline chips */
.tl{display:block;padding:2px 7px;font-family:'JetBrains Mono',monospace;font-size:9.5px;border:1px solid var(--border);border-radius:2px;color:var(--txts);background:var(--off);margin:2px 0;width:fit-content}
.tl.a{border-color:var(--green-b);background:var(--green-bg);color:var(--green)}
.tl.w{border-color:var(--red-b);background:var(--red-bg);color:var(--red)}

/* source links */
.src{display:block;padding:3px 8px;background:var(--navy);color:#fff !important;text-decoration:none;border-radius:2px;font-family:'JetBrains Mono',monospace;font-size:8.5px;letter-spacing:.04em;margin-bottom:3px;width:fit-content;transition:background .12s,transform .08s}
.src:hover{background:var(--navy-soft);transform:translateX(2px)}
.src.empty{background:var(--border);color:var(--txtm) !important;pointer-events:none;opacity:.65}

/* ── MAP VIEW ── */
.map-view{padding:28px 56px 24px;display:block}
.map-head{display:flex;align-items:flex-start;justify-content:space-between;margin-bottom:24px;gap:24px}
.map-title{font-family:'Playfair Display',serif;font-size:22px;font-weight:600;color:var(--navy);margin-bottom:4px}
.map-sub{font-family:'JetBrains Mono',monospace;font-size:10px;letter-spacing:.1em;color:var(--txtm);text-transform:uppercase}
.legend{display:flex;flex-direction:column;gap:7px;flex-shrink:0}
.leg-row{display:flex;align-items:center;gap:10px;font-family:'JetBrains Mono',monospace;font-size:10px;color:var(--txts)}
.lt{width:22px;height:22px;border-radius:3px;flex-shrink:0}
.lt-none{background:#dde3ea;border:1.5px solid #b8c4cf}
.lt-state{background:var(--navy);border:1.5px solid #000;transform:translateY(-3px);box-shadow:0 4px 0 rgba(0,0,0,.35)}
.lt-fed{background:#2c4a63;border:1.5px solid #1a2e42;transform:translateY(-2px);box-shadow:0 3px 0 rgba(0,0,0,.3)}

.carto-wrap{background:var(--white);border:1px solid var(--border);border-radius:6px;padding:32px 40px;overflow-x:auto}
.carto-grid{display:grid;grid-template-columns:repeat(12,54px);grid-template-rows:repeat(8,54px);gap:5px;width:fit-content;margin:0 auto}
.sq{width:54px;height:54px;border-radius:4px;display:flex;flex-direction:column;align-items:center;justify-content:center;font-family:'JetBrains Mono',monospace;font-size:10px;font-weight:500;letter-spacing:.04em;position:relative;user-select:none;transition:transform .12s,box-shadow .12s}
.sq-none{background:#dde3ea;border:1.5px solid #b8c4cf;color:#7a8fa0;cursor:default}
.sq-state{background:var(--navy);border:1.5px solid #000;color:#fff;transform:translateY(-4px);box-shadow:0 5px 0 #000,0 6px 10px rgba(0,0,0,.2);cursor:pointer;z-index:2}
.sq-state:hover{background:var(--navy-soft);transform:translateY(-6px);box-shadow:0 7px 0 #000,0 8px 14px rgba(0,0,0,.25)}
.sq-fed{background:#2c4a63;border:1.5px solid #1a2e42;color:#aaccde;transform:translateY(-2px);box-shadow:0 3px 0 #0d1b2a;cursor:pointer;z-index:1}
.sq-fed:hover{transform:translateY(-4px);box-shadow:0 5px 0 #0d1b2a}
.sq-cnt{position:absolute;top:4px;right:4px;background:rgba(255,255,255,.9);color:var(--navy);font-size:7.5px;font-weight:700;width:14px;height:14px;border-radius:50%;display:flex;align-items:center;justify-content:center;line-height:1}

/* ── POPUP ── */
.pop-overlay{position:fixed;inset:0;background:rgba(13,27,42,.55);z-index:300;display:flex;align-items:center;justify-content:center;padding:40px;backdrop-filter:blur(2px);opacity:0;pointer-events:none;transition:opacity .18s}
.pop-overlay.open{opacity:1;pointer-events:all}
.pop-box{background:var(--white);border:1px solid var(--border);border-radius:6px;box-shadow:0 24px 64px rgba(0,0,0,.22);width:100%;max-width:920px;max-height:82vh;overflow:hidden;display:flex;flex-direction:column;transform:translateY(14px);transition:transform .18s}
.pop-overlay.open .pop-box{transform:translateY(0)}
.pop-head{background:var(--navy);padding:18px 24px 16px;display:flex;align-items:flex-start;justify-content:space-between;flex-shrink:0}
.pop-tag{font-family:'JetBrains Mono',monospace;font-size:9px;letter-spacing:.16em;text-transform:uppercase;color:var(--navy-pale);margin-bottom:5px}
.pop-name{font-family:'Playfair Display',serif;font-size:24px;font-weight:700;color:#fff;line-height:1}
.pop-sub{font-family:'JetBrains Mono',monospace;font-size:10px;color:rgba(255,255,255,.4);margin-top:3px;letter-spacing:.05em}
.pop-close{background:rgba(255,255,255,.1);border:1px solid rgba(255,255,255,.15);color:#fff;border-radius:3px;width:28px;height:28px;display:flex;align-items:center;justify-content:center;cursor:pointer;font-size:14px;flex-shrink:0;transition:background .12s}
.pop-close:hover{background:rgba(255,255,255,.22)}
.pop-body{overflow-y:auto;flex:1}
.pop-tbl{width:100%;border-collapse:collapse;min-width:700px}
.pop-tbl thead tr{background:var(--navy-mid);position:sticky;top:0;z-index:10}
.pop-tbl th{padding:8px 13px;font-family:'JetBrains Mono',monospace;font-size:8px;letter-spacing:.1em;text-transform:uppercase;color:var(--navy-pale);font-weight:400;border-right:1px solid rgba(255,255,255,.06);text-align:left;white-space:nowrap}
.pop-tbl th:last-child{border-right:none}
.pop-tbl td{padding:12px 13px;vertical-align:top;border-right:1px solid var(--border-s);font-size:12px;color:var(--txts);line-height:1.5;border-bottom:1px solid var(--border-s)}
.pop-tbl td:last-child{border-right:none}
.pop-tbl tr:last-child td{border-bottom:none}
.pop-tbl tr:hover td{background:#f5f3ee}
.pop-law{font-family:'Source Serif 4',serif;font-weight:500;color:var(--navy);font-size:12.5px;margin-bottom:2px}
.pop-id{font-family:'JetBrains Mono',monospace;font-size:9px;color:var(--navy-muted)}

/* ── RIBBON ── */
.ribbon{position:fixed;bottom:0;left:0;right:0;height:var(--ribbon);background:var(--navy);border-top:1px solid rgba(255,255,255,.08);display:flex;align-items:center;justify-content:space-between;padding:0 56px;z-index:200}
.rib-l{font-family:'JetBrains Mono',monospace;font-size:9.5px;color:var(--navy-pale);letter-spacing:.08em;display:flex;align-items:center;gap:14px}
.rib-dot{width:3px;height:3px;border-radius:50%;background:var(--navy-pale);opacity:.5}
.rib-authors{font-family:'Source Serif 4',serif;font-size:11px;font-style:italic;color:rgba(255,255,255,.55)}
.rib-r{font-family:'JetBrains Mono',monospace;font-size:9px;color:rgba(255,255,255,.28);letter-spacing:.06em}

/* ── PRINT ── */
@media print{
  .toolbar,.col-panel,.ribbon,.kb-hint,.pop-overlay,.scroll-hint{display:none !important}
  body{padding-bottom:0;font-size:11px}
  .tbl-view{padding:12px}
  table{min-width:auto}
  tbody tr{page-break-inside:avoid}
  tr.expanded .trunc,tr .trunc{max-height:none;overflow:visible}
  .more-hint{display:none}
}
</style>
</head>
<body>

<!-- HEADER -->
<div class="hdr">
  <div class="hdr-in">
    <div class="hdr-tag">Policy Intelligence · Global AI Governance</div>
    <div class="hdr-title">Model Cards &amp; <em>AI Legislation</em></div>
    <div class="hdr-desc">Every legislative instrument, executive policy, and regulatory framework that explicitly or substantively engages with model card transparency, accountability, and auditability — as of April 2026.</div>
    <div class="hdr-stats">
      <div class="stat"><span class="stat-n" id="statTotal">26</span><span class="stat-l">Instruments</span></div>
      <div class="stat"><span class="stat-n">11</span><span class="stat-l">Jurisdictions</span></div>
      <div class="stat"><span class="stat-n">16</span><span class="stat-l">In Force</span></div>
      <div class="stat"><span class="stat-n">6</span><span class="stat-l">Not Passed</span></div>
    </div>
  </div>
</div>

<!-- TOOLBAR -->
<div class="toolbar">
  <!-- View tabs -->
  <button class="view-tab active" id="tabTable" onclick="setView('table')">⊞&nbsp; Table</button>
  <button class="view-tab" id="tabMap" onclick="setView('map')">◫&nbsp; US Map</button>
  <div class="tb-sep"></div>

  <!-- Region filter -->
  <div class="tb-section">
    <span class="tb-lbl">Region</span>
    <button class="chip on" data-region="all" onclick="setRegion(this)">All</button>
    <button class="chip" data-region="federal" onclick="setRegion(this)">Federal</button>
    <button class="chip" data-region="state" onclick="setRegion(this)">State</button>
    <button class="chip" data-region="local" onclick="setRegion(this)">Local</button>
    <button class="chip" data-region="international" onclick="setRegion(this)">International</button>
    <button class="chip" data-region="voluntary" onclick="setRegion(this)">Voluntary</button>
  </div>
  <div class="tb-sep"></div>

  <!-- Status filter -->
  <div class="tb-section">
    <span class="tb-lbl">Status</span>

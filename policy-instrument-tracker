function setView(view){
  const isMap = view==='map';
  document.getElementById('tableView').classList.toggle('hidden', isMap);
  document.getElementById('mapView').classList.toggle('hidden', !isMap);
  document.getElementById('tabTable').classList.toggle('active', !isMap);
  document.getElementById('tabMap').classList.toggle('active', isMap);
  const p = new URLSearchParams(window.location.search);
  p.set('view',view); history.replaceState(null,'','?'+p.toString());
}

// ═══════════════════════════════════════════════════════════
// MAP: BUILD CARTOGRAM
// ═══════════════════════════════════════════════════════════
function buildCarto(){
  const grid = document.getElementById('cartoGrid');
  MAP_STATES.forEach(([code, col, row, type])=>{
    const div = document.createElement('div');
    div.style.gridColumn = col;
    div.style.gridRow = row;
    const count = STATE_COUNTS[code]||0;
    if(type==='state'){
      div.className = 'sq sq-state';
      div.title = `${STATE_NAMES[code]||code} — ${count} instrument${count!==1?'s':''}`;
      div.innerHTML = `${code}<span class="sq-cnt">${count}</span>`;
      div.onclick = ()=>openStatePopup(code);
    } else if(type==='fed'){
      div.className = 'sq sq-fed';
      div.title = `DC / Federal — ${count}+ instruments`;
      div.innerHTML = `${code}<span class="sq-cnt">${count}+</span>`;
      div.onclick = ()=>openStatePopup(code);
    } else {
      div.className = 'sq sq-none';
      div.textContent = code;
    }
    grid.appendChild(div);
  });
}

// ═══════════════════════════════════════════════════════════
// MAP POPUP
// ═══════════════════════════════════════════════════════════
function openStatePopup(code){
  const ids   = STATE_ROWS[code]||[];
  const rows  = DATA.filter(d=>ids.includes(d.id));
  const name  = STATE_NAMES[code]||code;
  const isFed = code==='DC';
  document.getElementById('popTag').textContent  = isFed?'Federal Legislation · United States':`State Legislation · United States`;
  document.getElementById('popName').textContent = name;
  document.getElementById('popSub').textContent  = `${rows.length} instrument${rows.length!==1?'s':''} tracked`;
  // Build mini table
  const tbody_rows = rows.map(d=>`
    <tr>
      <td><div class="pop-law">${d.name}</div><div class="pop-id">${d.billId}</div></td>
      <td><span class="status ${d.status==='force'?'s-g':'s-r'}">${d.statusLabel}</span></td>
      <td>${srcLink(d.src1url,d.src1label)}</td>
      <td>${bl(d.relevance)}</td>
      <td>${bl(d.specific)}</td>
      <td>${bl(d.implications)}</td>
      <td>${tls(d.passageTimeline)}</td>
      <td>${tls(d.activationTimeline)}</td>
      <td>${srcLink(d.src2url,d.src2label)}${srcLink(d.src3url,d.src3label)}</td>
    </tr>`).join('');
  document.getElementById('popBody').innerHTML = `
    <table class="pop-tbl">
      <thead><tr>
        <th style="width:180px">Law / Bill Name</th>
        <th style="width:95px">Status</th>
        <th style="width:72px">Source 1</th>
        <th style="width:195px">Relevance</th>
        <th style="width:185px">Specific References</th>
        <th style="width:175px">Implications</th>
        <th style="width:115px">Passage</th>
        <th style="width:125px">Activation</th>
        <th style="width:78px">Sources</th>
      </tr></thead>
      <tbody>${tbody_rows}</tbody>
    </table>`;
  document.getElementById('popOverlay').classList.add('open');
}
function closePopup(){
  document.getElementById('popOverlay').classList.remove('open');
}
function handleOverlayClick(e){
  if(e.target===document.getElementById('popOverlay')) closePopup();
}


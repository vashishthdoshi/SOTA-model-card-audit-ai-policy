// ═══════════════════════════════════════════════════════════
// CSV EXPORT
// ═══════════════════════════════════════════════════════════
function exportCSV(){
  const filtered = getSorted(getFiltered());
  const headers = ['Region','Jurisdiction','Law/Bill Name','Bill ID','Status','Source 1 URL','Relevance','Specific References','Implications','Passage Timeline','Activation Timeline','Source 2 URL','Source 3 URL'];
  const esc = v => '"'+String(v||'').replace(/"/g,'""')+'"';
  const rows = [headers.map(esc).join(',')];
  filtered.forEach(d=>{
    rows.push([
      d.regionLabel, d.jurisdiction, d.name, d.billId, d.statusLabel,
      d.src1url||'',
      d.relevance.join(' | '), d.specific.join(' | '), d.implications.join(' | '),
      d.passageTimeline.map(t=>t.l).join(' | '),
      d.activationTimeline.map(t=>t.l).join(' | '),
      d.src2url||'', d.src3url||''
    ].map(esc).join(','));
  });
  const blob = new Blob([rows.join('\n')],{type:'text/csv;charset=utf-8;'});
  const a = document.createElement('a');
  a.href = URL.createObjectURL(blob);
  a.download = 'model_cards_legislation_CMU80736.csv';
  a.click();
}

// ═══════════════════════════════════════════════════════════
// KEYBOARD NAVIGATION
// ═══════════════════════════════════════════════════════════
function toggleKbHint(){
  kbVisible = !kbVisible;
  document.getElementById('kbHint').classList.toggle('show', kbVisible);
}
function highlightFocused(){
  document.querySelectorAll('#tableBody tr').forEach((tr,i)=>{
    tr.classList.toggle('focused', i===focusedRow);
  });
  const el = document.querySelectorAll('#tableBody tr')[focusedRow];
  if(el) el.scrollIntoView({block:'nearest',behavior:'smooth'});
}
document.addEventListener('keydown', e=>{
  if(document.getElementById('searchInput')===document.activeElement) return;
  const popOpen = document.getElementById('popOverlay').classList.contains('open');
  if(e.key==='Escape'){
    if(popOpen){ closePopup(); return; }
    document.querySelectorAll('#tableBody tr.expanded').forEach(tr=>tr.classList.remove('expanded'));
    return;
  }
  if(popOpen) return;
  const rows = document.querySelectorAll('#tableBody tr');
  if(!rows.length) return;
  if(e.key==='ArrowDown'){
    e.preventDefault();
    focusedRow = Math.min(focusedRow+1, rows.length-1);
    highlightFocused();
  } else if(e.key==='ArrowUp'){
    e.preventDefault();
    focusedRow = Math.max(focusedRow-1, 0);
    highlightFocused();
  } else if(e.key==='Enter'){
    if(focusedRow>=0&&focusedRow<rows.length) rows[focusedRow].classList.toggle('expanded');
  }
});

// ═══════════════════════════════════════════════════════════
// VIEW TOGGLE
